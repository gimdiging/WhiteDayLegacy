Init()
{
//	$TalkingStep = 0;
	if($old_LegacyEvents == ON)
	{
		$old_TalkingStep = 0;
		SendMessage("타이머", "스크립트설정", "0 0 1 old_대화1-4.Talking");
	}
	else
	{
		SetValue("$old_TalkingStep", $old_TalkingStep <= 1 ? $old_TalkingStep + 1 : 1);
		SendMessage("매크로", "Play", "old_talk1_4.cut01");
	}
}

Talking()
{
	$TalkIndex = GetObjValue("TalkIndex");
	
//	if($TalkingStep == 0)
	if($old_TalkingStep == 0)
	{
		SendMessage("자막", "활성화", "");
//		SendMessage("자막", "SetFunction", "대화#1-4.Talking");
//		SendMessage("자막", "SetObject", "성아");
		SendMessage("자막", "말하는사람", "성아");
//		SendMessage("성아", "바라보기", "유저");
		SendMessage("성아", "쳐다보기", "유저");

		switch($TalkIndex)
		{
			case 0:
			{
//				SendMessage("자막", "다이얼로그출력", "d02_012");
				SendMessage("자막", "다이얼로그출력", "old_d02_012");
				SendMessage("타이머", "스크립트설정", "6 0 1 old_대화1-4.Talking");
				break;
			}
			case 1:
			{
//				SendMessage("자막", "다이얼로그출력", "d02_013");
				SendMessage("자막", "다이얼로그출력", "old_d02_013");
				SendMessage("타이머", "스크립트설정", "2 0 1 old_대화1-4.Talking");
				break;
			}
		}
//		$TalkingStep = 1;
		$old_TalkingStep = 1;
	}
	else
	{
		SendMessage("자막", "비활성", "");
//		SendMessage("자막", "SetFunction", "");
//		SendMessage("자막", "SetObject", "");
		SendMessage("자막", "말하는사람", "");
		SendMessage("성아", "쳐다보지말기", "");
//		$TalkingStep = 0;
		$old_TalkingStep = 0;
		return;
	}

	SetObjValue("TalkIndex", $TalkIndex <= 0 ? $TalkIndex + 1 : 0);
}
