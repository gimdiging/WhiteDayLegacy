Init()
{
//	SendMessage("", "스크립트설정", "use " + $WorkingFile);
	SendMessage("", "스크립트설정", "use " + $G_File);
	SetObjValue("Step", 0);
//	SetObjValue("KeyName", "목의조각");
	SetObjValue("KeyName", "old_목의조각");
//	SetObjValue("Lock", "$문_1층서무실옆방화셔터");
	SetObjValue("Lock", "$old_문_1층서무실옆방화셔터");
}

Init목의문장()
{
	SendMessage("", "반짝", "off");
	SendMessage("", "페이드", "Recursive 0 0 0");
	SetObjName("목의문장");
}

pick()
{
	$KeyName = GetObjValue("KeyName");
	$Lock = GetValue(GetObjValue("Lock"));
	$Step = GetObjValue("Step");
	
	if($Lock == LOCK)
	{
		if($Step == 0)
		{
			return "보기";
		}
		else
		{
//			return GetObjValue("UserItem") == $KeyName ? "i목의조각" : "잡기";
			return $G_UserItem == $KeyName ? "iold_목의조각" : "잡기";
		}
	}
	return "";
}

click()
{
	$KeyName  = GetObjValue("KeyName");
	$Lock = GetValue(GetObjValue("Lock"));
	$Step = GetObjValue("Step");
	
	if($Lock == LOCK)
	{
		if($Step == 0)
		{
			if($LUM_STICK <= 128.0)
			{
//				SendMessage("자막", "문자출력", "2,무언가 희미하게 보인다");
				SendMessage("자막", "문자출력", "2," +  GetString("old_s86"));
			}
			else
			{
//				SendMessage("자막", "문자출력", "2,나무 '목'자가 음각되어 있다");
				SendMessage("자막", "문자출력", "2," +  GetString("old_s87"));
			}
			SetObjValue("Step", $Step + 1);
		}
		else
		{
//			if(GetObjValue("UserItem") == $KeyName)
			if($G_UserItem == $KeyName)
			{
				if($LUM_STICK <= 128.0)
				{
//					SendMessage("자막", "문자출력", "2,너무 어둡다");
					SendMessage("자막", "문자출력", "2," +  GetString("old_s88"));
				}
				else
				{
					SetValue(GetObjValue("Lock"), UNLOCK);
//					SendMessage("", "페이드", "Recursive 1 1 0");
//					SendMessage("유저", "폐기", "목의조각");
					SendMessage("유저", "폐기", "@old_목의조각");
					SendMessage("목의문장", "페이드", "Recursive 0 1 1");
				}
			}
			else
			{
//				SendMessage("자막", "문자출력", "2,아무런 반응도 일어나지 않는다");
				SendMessage("자막", "문자출력", "2," +  GetString("old_s80"));
			}
		}
	}
}
