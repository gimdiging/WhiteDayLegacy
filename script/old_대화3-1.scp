Init()
{
	DeleteObject("");	// EventArea
//	if($Mission4_나무 == OFF)
	if($old_Mission4_나무 == OFF)
	{
		if($old_LegacyEvents == ON)
		{
//			$TalkingStep = 0;
			$old_TalkingStep = 0;
			Talking();
		}
		else
			SendMessage("매크로", "Play", "old_talk3_1.cut01");
	}
}

Talking()
{
//	switch($TalkingStep)
	switch($old_TalkingStep)
	{
		case 0:
		{
			SendMessage("자막", "활성화", "");
			SendMessage("자막", "와이드모드", "켜기");
//			SendMessage("자막", "SetObject", "소영");
//			SendMessage("자막", "SetFunction", "대화#3-1.Talking");
			SendMessage("자막", "말하는사람", "소영");
//			SendMessage("유저", "바라보기", "소영");
			SendMessage("유저", "쳐다보기", "소영");
			SendMessage("타이머", "스크립트설정", "0 0 1 old_대화3-1.Talking");
			break;
		}
		case 1:
		{
//			SendMessage("타이머", "스크립트설정", "1 0 1 대화#3-1.Talking");
			SendMessage("타이머", "스크립트설정", "1 0 1 old_대화3-1.Talking");
			break;
		}
		case 2:
		{
			SendMessage("유저", "쳐다보지말기", "");
//			SendMessage("자막", "다이얼로그출력", "d04_001");
			SendMessage("자막", "다이얼로그출력", "old_d04_001");
//			SendMessage("나무윗쪽", "애니메이션", "*force 공격");
			SendMessage("나무윗쪽", "애니메이션", "공격");
			SendMessage("타이머", "스크립트설정", "5 0 1 old_대화3-1.Talking");
			break;
		}	
		case 3:
		{
//			SendMessage("자막", "문자출력", "2,한소영이 보인다");
			SendMessage("자막", "문자출력", "2," +  GetString("old_s107"));
			SendMessage("타이머", "스크립트설정", "2 0 1 old_대화3-1.Talking");
			break;
		}	
		case 4:
		{
//			SendMessage("자막", "선택", "내가 도와 줄께!\n너 거기서 뭐해?");
			SendMessage("자막", "선택", GetString("old_s108"));
			SendMessage("자막", "실행함수", "old_대화3-1.Talking");
			break;
		}
		case 5:
		{
//			SendMessage("자막", "다이얼로그출력", "d04_003");
			SendMessage("자막", "다이얼로그출력", "old_d04_003");
			SendMessage("타이머", "스크립트설정", "4 0 1 old_대화3-1.Talking");
			break;
		}
		case 6:
		{
//			SendMessage("소영", "표정바꿔", "고통");
			SendMessage("소영", "표정바꿔", "고통m");
			SendMessage("자막", "비활성", "");
			SendMessage("자막", "와이드모드", "끄기");
//			SendMessage("자막", "SetObject", "");
//			SendMessage("자막", "SetFunction", "");
			SendMessage("자막", "말하는사람", "");
			$old_Mission4_대화 = ON;
//			SendMessage("타이머", "스크립트설정", "2 0 1 대화#3-1.ShotUp *obj 나무윗쪽");
			SendMessage("타이머", "스크립트설정", "2 0 1 old_대화3-1.ShotUp *obj 나무윗쪽");
			break;
		}	
	}
	$TalkingStep++;
}

ShotUp()
{
	if($old_GameOver == TRUE)
		return;

//	if($Mission4_나무 == OFF)
	if($old_Mission4_나무 == OFF)
	{
//		SendMessage("사운드", "연주3d", GetObjPos("소영") + " data/sound/voice/" + (GetObjValue("ShotIndex") ? "d04_002.adp" : "d04_003.adp"));
		if(xz_distance(GetObjPos("유저"), GetObjPos("소영")) < 1000)
		{
			SendMessage("자막", "말하는사람", "소영");
			SendMessage("자막", "다이얼로그출력", "" + (GetObjValue("ShotIndex") ? "old_d04_002" : "old_d04_003"));
			SetObjValue("ShotIndex", !GetObjValue("ShotIndex"));
		}
		else
			SendMessage("자막", "말하는사람", "");
//		SendMessage("타이머", "스크립트설정", "8 0 1 대화#3-1.ShotUp *obj 나무윗쪽");
		SendMessage("타이머", "스크립트설정", "8 0 1 old_대화3-1.ShotUp *obj 나무윗쪽");
	}
}
