Init()
{
//	$TalkingStep = 0;
	$old_TalkingStep = 0;
	if($old_LegacyEvents == ON)
		SendMessage("타이머", "스크립트설정", "0 0 1 old_대화1-3.Talking");
	else
		SendMessage("매크로", "Play", "old_talk1_3.cut01");
}

