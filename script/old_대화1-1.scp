Walk()
{
	SendMessage("성아", "애니메이션", "걷기2");
}

Run()
{
	SendMessage("성아", "애니메이션", "귀막고달리기");
}

Rotate()
{
	SendMessage("성아", "회전", "0");
}

SitDown()
