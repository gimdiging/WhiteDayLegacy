		SendMessage("타이머", "스크립트설정", "0 0 1 old_대화1-1.Talking");
	else
		SendMessage("매크로", "Play", "old_talk1_1.cut01");
	DeleteObject("");	// EventArea
//	$TalkingStep = 0;
	$old_TalkingStep = 0;
}

